{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCG-HCWS BootLoops Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "package",
    "verification_class",
    "status",
    "returncode",
    "timeout_seconds",
    "elapsed_seconds",
    "bootloops_ref",
    "bootloops_worktree_clean_before",
    "bootloops_worktree_clean_after",
    "environment",
    "stdout_sha256",
    "result_sha256",
    "result"
  ],
  "properties": {
    "schema": {"const": "scg-hcws-bootloops-receipt-v1"},
    "job_id": {"type": "string", "minLength": 8, "pattern": "^[0-9a-f]+$"},
    "package": {"type": "string", "minLength": 1},
    "verification_class": {"type": "string", "enum": ["selftest", "partial", "smoke", "data-gated"]},
    "status": {
      "type": "string",
      "enum": ["PASS", "REFUSED (by design)", "FAIL", "PROCESS_TIMEOUT", "PROCESS_ERROR", "UNKNOWN"]
    },
    "returncode": {"type": "integer"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "bootloops_root": {"type": "string", "minLength": 1},
    "bootloops_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bootloops_worktree_clean_before": {"const": true},
    "bootloops_worktree_clean_after": {"const": true},
    "unexpected_worktree_changes": {"type": "array", "items": {"type": "string"}},
    "command": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "environment": {
      "type": "object",
      "required": ["platform", "python", "dependencies", "engines"],
      "properties": {
        "platform": {"type": "string"},
        "python": {"type": "string", "minLength": 1},
        "dependencies": {"type": "object"},
        "engines": {"type": "object"}
      },
      "additionalProperties": true
    },
    "result": {"anyOf": [{"type": "object"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "required": ["result_sha256"],
        "properties": {"result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"type": "object"}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "REFUSED (by design)"}}},
      "then": {
        "required": ["result_sha256"],
        "properties": {"result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"type": "object"}}
      }
    }
  ],
  "additionalProperties": true
}
